createNode reference -n "majia_model_grimoire_publishRN";
	rename -uid "77123F44-4F59-1B84-A1CC-BFA7CD262CA2";
	setAttr ".ed" -type "dataReferenceEdits" 
		"majia_model_grimoire_publishRN"
		"majia_model_grimoire_publishRN" 1
		2 "|majia_model_grimoire_publish:grimoire_grp|majia_model_grimoire_publish:bookSize_ctrl|majia_model_grimoire_publish:upperSpineAndCover_clstr" 
		"inheritsTransform" " 1"
		"majia_model_grimoire_publishRN" 6
		2 "|majia_model_grimoire_publish:grimoire_grp" "rotate" " -type \"double3\" 0 0 0"
		
		2 "|majia_model_grimoire_publish:grimoire_grp" "scale" " -type \"double3\" 1 1 1"
		
		2 "|majia_model_grimoire_publish:grimoire_grp|majia_model_grimoire_publish:spine_ctrl" 
		"rotate" " -type \"double3\" 0 0 0"
		2 "|majia_model_grimoire_publish:grimoire_grp|majia_model_grimoire_publish:spine_ctrl|majia_model_grimoire_publish:bookSize_ctrl" 
		"translate" " -type \"double3\" 0 0 0"
		2 "|majia_model_grimoire_publish:grimoire_grp|majia_model_grimoire_publish:spine_ctrl|majia_model_grimoire_publish:bookSize_ctrl" 
		"scale" " -type \"double3\" 1 1 1"
		2 "|majia_model_grimoire_publish:grimoire_grp|majia_model_grimoire_publish:spine_ctrl|majia_model_grimoire_publish:bookSize_ctrl" 
